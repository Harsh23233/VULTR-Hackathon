# Copy to .env (scripts/init_env.py does this and fills the random values).

# Vultr Serverless Inference: Vultr console > Serverless > Inference > your subscription > API key
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# vultr = real models (required for the hackathon). scripted = canned answers for tests and offline dev only.
GLOVEBOX_INFERENCE=vultr

# Model roster (validated against the live catalog at startup)
MODEL_PLANNER=glm-5.3
MODEL_CODER=deepseek-v4.1-flash-1017
MODEL_ACTOR=minimax-m3.1-flash
MODEL_VERIFIER=qwen3.8-27b
MODEL_READER=qwen3.8-flash-next
MODEL_EXPLAINER=deepseek-v4.1-flash-1017
MODEL_SAFETY=nemotron-3.5-content-safety
MODEL_DECISION=clef

# Runner (sandbox host). Production: the runner's Vultr VPC address.
RUNNER_URL=http://127.0.0.1:8081
RUNNER_TOKEN=
MAX_SANDBOXES=4

# Mock ERP API on the control plane, and how sandboxes reach it.
# Local: host.microsandbox.internal. Vultr: the control plane's VPC IP, and bind ERP to that IP.
ERP_BIND=127.0.0.1:8090
ERP_GUEST_HOST=host.microsandbox.internal
ERP_GUEST_PORT=8090
ERP_SCHEME=http

# Mock vendor sites for Operator missions (ports 8101-8103), and how browser sandboxes reach them.
# Same pattern as the ERP: local host.microsandbox.internal; Vultr: the control plane's VPC IP for both.
VENDOR_BIND=127.0.0.1
VENDOR_GUEST_HOST=host.microsandbox.internal
VENDOR_DOMAIN=vendors.glovebox.test

# Receipts are signed with this Ed25519 seed (base64, 32 bytes). Control plane only.
RECEIPT_SIGNING_KEY=

PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_CONCURRENT_MISSIONS=2
